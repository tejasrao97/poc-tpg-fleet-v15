{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/<org>/tpg-fleet/workflows/params/schemas/clustermap-network-policy.schema.json",
  "title": "clusterMap of tpg-network-policy",
  "description": "The clusterMap input of the WorkflowTemplate tpg-network-policy: registered clusters, their keys and their instances. Generated from workflows/params/cluster-map-keys.yaml by workflows/params/clustermap_schema.py; the validate step of the workflow is the authority (registered clusters, required values an input may supply, combinations of values).",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {
    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
  },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "instances": {
        "type": "object",
        "minProperties": 1,
        "description": "The instances of the cluster (namespace pg-<instance>); at least one",
        "propertyNames": {
          "pattern": "^[a-z]([-a-z0-9]{0,38}[a-z0-9])?$"
        },
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "postgresVersion": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^(postgres-)?[0-9]+(\\.[0-9]+)?$"
                }
              ],
              "description": "tpg-day0, tpg-create-instance and tpg-upgrade: the version to deploy or upgrade to. Guard in the other workflows: when set, an instance that runs another version is skipped (SKIPPED_VERSION_MISMATCH) and nothing is changed for it [String (version); guard (skip an instance that runs another version)]"
            },
            "ingressFromNamespaces": {
              "anyOf": [
                {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z]([-a-z0-9]{0,38}[a-z0-9])?$"
                  }
                },
                {
                  "type": "string",
                  "pattern": "^\\s*[a-z]([-a-z0-9]{0,38}[a-z0-9])?(\\s*,\\s*[a-z]([-a-z0-9]{0,38}[a-z0-9])?)*\\s*$"
                }
              ],
              "description": "Namespaces whose pods may reach 5432 [List; optional (default: the input ingressFromNamespaces)]"
            },
            "ingressFromPodLabels": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
              },
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "description": "Pod labels allowed to reach 5432 [Map; optional (default: the input ingressFromPodLabels)]"
            },
            "ingressFromCidrs": {
              "anyOf": [
                {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$"
                  }
                },
                {
                  "type": "string",
                  "pattern": "^\\s*[0-9A-Fa-f:.]+/[0-9]{1,3}(\\s*,\\s*[0-9A-Fa-f:.]+/[0-9]{1,3})*\\s*$"
                }
              ],
              "description": "Client ranges allowed to reach 5432 [List (CIDRs); optional (default: the input ingressFromCidrs)]"
            },
            "egressToCidrs": {
              "anyOf": [
                {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$"
                  }
                },
                {
                  "type": "string",
                  "pattern": "^\\s*[0-9A-Fa-f:.]+/[0-9]{1,3}(\\s*,\\s*[0-9A-Fa-f:.]+/[0-9]{1,3})*\\s*$"
                }
              ],
              "description": "Extra egress ranges [List (CIDRs); optional (default: the input egressToCidrs)]"
            },
            "egressToFqdns": {
              "anyOf": [
                {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^(\\*\\.)?([a-z0-9]([-a-z0-9]*[a-z0-9])?\\.)+[a-z]{2,}$"
                  }
                },
                {
                  "type": "string",
                  "pattern": "^\\s*(\\*\\.)?([a-z0-9]([-a-z0-9]*[a-z0-9])?\\.)+[a-z]{2,}(\\s*,\\s*(\\*\\.)?([a-z0-9]([-a-z0-9]*[a-z0-9])?\\.)+[a-z]{2,})*\\s*$"
                }
              ],
              "description": "Egress host names (needs ACNS) [List (host names); optional (default: the input egressToFqdns)]"
            }
          }
        }
      }
    },
    "required": [
      "instances"
    ]
  }
}
